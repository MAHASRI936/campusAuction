# Copy this file to `.env` (same folder) and fill in YOUR values.
# `.env` is ignored by git. NEVER commit it and NEVER paste a service-role / secret key here.
#
# Where to find them: Supabase dashboard -> Project Settings -> API (or "API Keys").
#   Project URL            -> VITE_SUPABASE_URL
#   anon / publishable key -> VITE_SUPABASE_ANON_KEY   (the PUBLIC one, not the secret one)
#
# After editing .env, stop and restart `npm run dev` (Vite reads it at start-up).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
